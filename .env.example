# Optional automation endpoint for lead submissions.
# Works with Zapier, Make, n8n, HubSpot workflows, Airtable automations, or a custom CRM endpoint.
LEAD_WEBHOOK_URL=

# Optional bearer token sent as Authorization: Bearer <token>.
LEAD_WEBHOOK_SECRET=

# Set to true if production form success should fail when webhook delivery fails.
REQUIRE_LEAD_WEBHOOK=false

# Direct lead notification email via SMTP.
# Titan Email commonly uses smtp.titan.email, port 465, and SSL/TLS.
SMTP_HOST=smtp.titan.email
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=kian@apexportfolio.me
SMTP_PASSWORD=
LEAD_EMAIL_TO=kian@apexportfolio.me
LEAD_EMAIL_FROM=APEX Leads <kian@apexportfolio.me>

# Set to true if production form success should fail when email delivery fails.
REQUIRE_LEAD_EMAIL=false
